# Required: use a long random value. Do not commit the real .env file.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=seo-rank-tracker-api
JWT_AUDIENCE=seo-rank-tracker-client
JWT_EXPIRES_IN=15m
CLIENT_ORIGINS=http://localhost:8080,http://localhost:5173
SERP_API_KEY=replace-with-your-serpapi-key

# Optional host port overrides.
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Optional. The default uses the MongoDB container and persistent volume.
# For MongoDB Atlas, replace this with your full mongodb+srv:// connection string.
MONGODB_URI=mongodb://mongo:27017/SEO_Rank_Tracker